# Normalise line endings in the repository; check out Windows scripts with CRLF (cmd.exe needs it for labels/goto)
# and shell scripts with LF, whatever core.autocrlf says on the cloning machine.
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf
*.mjs text eol=lf
*.js  text eol=lf
*.py  text eol=lf
# Text the tests read and match line by line (CSS rules, HTML, data, docs): LF everywhere, so a Windows checkout
# (core.autocrlf=true) runs `node --test` exactly like Linux and macOS.
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
# Text files without an extension (.dockerignore, Dockerfile, LICENSE): LF everywhere, like the listed types —
# core.autocrlf=true would otherwise hand a Windows checkout CRLF and break tests that read them line by line.
.dockerignore text eol=lf
Dockerfile text eol=lf
LICENSE text eol=lf
# binary assets
*.png binary
*.jpg binary
*.webp binary
*.skel binary
*.woff2 binary
*.otf binary
*.ttf binary
*.mp3 binary
*.ogg binary

# The attributes file itself, and every other extensionless text file above.
.gitattributes text eol=lf
